generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("OPERATIVO") // ADMINISTRADOR, SUPERVISOR, OPERATIVO, LECTURA
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  estimates    Estimate[]
  priceItems   PriceItem[]
  sessions     Session[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}

model PriceItem {
  id             String   @id @default(cuid())
  sku            String   @default("")
  system         String   // CCTV, ACCESO, VOCEO, INCENDIO, CANALIZACION, CABLEADO, GENERAL
  category       String   // Equipo, Accesorio, Consumible, Mano de Obra, Servicio
  brand          String   @default("")
  model          String   @default("")
  description    String
  unit           String   @default("pza") // pza, ml, mts, m.l., lote, servicio, kg, rollo
  unitCost       Float    @default(0)
  performance    Float    @default(0) // Rendimiento: m/hr o pzs/hr para mano de obra
  deviceType     String   @default("") // Para vincularlo con el motor de cálculo exacto
  // C1 - Campos ampliados (TASK §9.4)
  provider       String   @default("") // Proveedor / marca comercial
  certifications String   @default("") // Lista CSV: "UL, NOM, CE, FCC"
  datasheetUrl   String   @default("") // Enlace a la ficha técnica
  notes          String   @default("") // Observaciones internas
  // A2 - Mano de obra por cuadrilla
  crewTechnician Float    @default(0) // Cantidad de técnicos por unidad (Ej: 0.3)
  crewOfficer    Float    @default(0) // Cantidad de oficiales por unidad
  crewHelper     Float    @default(0) // Cantidad de ayudantes por unidad
  laborHours     Float    @default(0) // Horas-hombre por unidad (rendimiento)
  active         Boolean  @default(true)
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  // C3 - Historial de costos (TASK §18.3)
  history        PriceHistory[]

  @@index([userId])
  @@index([system])
  @@index([category])
  @@index([sku])
  @@index([active])
  @@index([system, active])
}

/// C3 - Historial de cambios en el costo unitario (TASK §18.3, §14.7)
model PriceHistory {
  id             String    @id @default(cuid())
  priceItemId    String
  priceItem      PriceItem @relation(fields: [priceItemId], references: [id], onDelete: Cascade)
  previousCost   Float     @default(0)
  newCost        Float     @default(0)
  delta          Float     @default(0)            // newCost - previousCost
  deltaPercent   Float     @default(0)            // (delta / previousCost) * 100
  changedBy      String    @default("")           // Usuario responsable
  reason         String    @default("")           // Motivo del cambio
  createdAt      DateTime  @default(now())

  @@index([priceItemId])
  @@index([createdAt])
}

model Estimate {
  id               String   @id @default(cuid())
  name             String   @default("Sin nombre")
  clientName       String   @default("")
  projectName      String   @default("")
  currency         String   @default("MXN") // MXN, USD
  revision         String   @default("Rev. 1")
  responsible      String   @default("")
  projectManager   String   @default("")
  startDate        String   @default("")
  endDate          String   @default("")
  techResponsable  String   @default("")
  envResponsable   String   @default("")
  riskResponsable  String   @default("")
  notes            String   @default("")
  factorsNotes     String   @default("")
  // Calculation factors
  wasteFactorCable       Float @default(0.10)       // 10% desperdicio cable
  wasteFactorConduit     Float @default(0.15)       // 15% desperdicio canalización
  verticalDrop           Float @default(3.0)        // metros bajada vertical promedio
  rackAllowance          Float @default(5.0)        // metros holgura en rack
  indirectFactor         Float @default(0.12)       // 12% indirectos
  ivaRate                Float @default(0.16)       // 16% IVA (TASK §9.1, §10)
  roundingPolicy         Int    @default(2)         // Decimales para redondeo (TASK §10)
  // A2 - Mano de obra por cuadrilla (TASK §6, §9.5)
  laborTechnicianRate    Float @default(950.0)      // MXN/hr
  laborOfficerRate       Float @default(750.0)      // MXN/hr
  laborHelperRate        Float @default(500.0)      // MXN/hr
  useCrewBasedLabor      Boolean @default(false)    // Activar cálculo por cuadrilla
  // System configs stored as JSON strings
  cctvConfig             String   @default("{}")
  accessConfig           String   @default("{}")
  pagingConfig           String   @default("{}")
  fireConfig             String   @default("{}")
  floorplanConfig        String   @default("{}")
  // Results
  lineItems              String   @default("[]")     // JSON array of calculated line items
  subtotalMaterials      Float    @default(0)
  subtotalLabor          Float    @default(0)
  subtotalEngineering    Float    @default(0)
  subtotalDirect         Float    @default(0)
  subtotalIndirects      Float    @default(0)
  grandTotal             Float    @default(0)
  iva                    Float    @default(0)
  totalWithIva           Float    @default(0)
  hasManualEdits         Boolean  @default(false)
  userId                 String?
  user                   User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  schedule               Schedule?
  history                EstimateHistory[]

  @@index([userId])
  @@index([updatedAt])
}

/// Historial de modificaciones y auditoría por presupuesto
model EstimateHistory {
  id           String   @id @default(cuid())
  estimateId   String
  estimate     Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  changeType   String   // "FILA_AGREGADA" | "FILA_EDITADA" | "FILA_ELIMINADA" | "PARAMETROS_ACTUALIZADOS" | "REVERSIÓN"
  user         String   @default("Sistema / Usuario")
  details      String   // Detalle descriptivo del cambio
  snapshot     String   @default("{}") // Snapshot JSON de los lineItems y totales calculados
  createdAt    DateTime @default(now())

  @@index([estimateId])
  @@index([createdAt])
}

model Schedule {
  id         String   @id @default(cuid())
  estimateId String   @unique
  estimate   Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  startDate  DateTime?
  endDate    DateTime?
  engineeringStatus        String   @default("")
  engineeringResponsible   String   @default("")
  engineeringDueDate       DateTime?
  engineeringJustification String   @default("")
  notes      String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  activities  ScheduleActivity[]
  milestones  ScheduleMilestone[]
  blockers    ScheduleBlocker[]
  documents   EngineeringDocument[]
  procurement ProcurementRecord?

  @@index([estimateId])
}

model ScheduleActivity {
  id           String   @id @default(cuid())
  scheduleId   String
  schedule     Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  name         String
  system       String   @default("")
  phase        Int      @default(0)
  startDate    DateTime?
  endDate      DateTime?
  assigneeRole String   @default("")
  status       String   @default("Pendiente")
  progress     Float    @default(0)
  dependsOn    String   @default("[]")
  risk         String   @default("")
  notes        String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([scheduleId])
  @@index([system])
  @@index([phase])
  @@index([status])
}

model ScheduleMilestone {
  id           String    @id @default(cuid())
  scheduleId   String
  schedule     Schedule  @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  name         String
  phase        String    @default("general")
  targetDate   DateTime?
  completedAt  DateTime?
  status       String    @default("pending")
  responsible  String    @default("")
  notes        String    @default("")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([scheduleId])
  @@index([status])
}

model ScheduleBlocker {
  id           String    @id @default(cuid())
  scheduleId   String
  schedule     Schedule  @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  activityId   String    @default("")
  reason       String
  severity     String    @default("medium")
  responsible  String    @default("")
  createdAt    DateTime  @default(now())
  releasedAt   DateTime?
  releaseNote  String    @default("")

  @@index([scheduleId])
}

model EngineeringDocument {
  id           String   @id @default(cuid())
  scheduleId   String
  schedule     Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  system       String   @default("")
  filename     String
  filepath     String
  revision     String   @default("")
  status       String   @default("Cargado")
  uploadedBy   String   @default("")
  uploadedAt   DateTime @default(now())
  notes        String   @default("")

  @@index([scheduleId])
  @@index([system])
  @@index([status])
}

model ProcurementRecord {
  id                        String   @id @default(cuid())
  scheduleId                String   @unique
  schedule                  Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  comparativeRequestedAt     DateTime?
  comparativeMinExpectedAt   DateTime?
  comparativeReceivedAt      DateTime?
  supplierName              String   @default("")
  quotedAmount              Float    @default(0)
  deliveryLeadTimeDays       Int      @default(0)
  paymentTerms              String   @default("")
  advancePercent             Float    @default(0)
  requisitionNumber          String   @default("")
  purchaseOrderNumber        String   @default("")
  advanceReleasedAt          DateTime?
  supplierPurchaseStartedAt  DateTime?
  materialsReceivedAt        DateTime?
  releasedForInstallationAt  DateTime?
  status                    String   @default("Pendiente")
  notes                     String   @default("")
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@index([status])
}
