# ==========================================
# LOW-VOLTAGE ESTIMATOR - ENV VARIABLES
# ==========================================

# Base de Datos (Prisma)
DATABASE_URL="file:./db/custom.db"

# Better Auth - Clave Secreta y URL Base (Producción)
BETTER_AUTH_SECRET="tu_secreto_super_seguro_generado_en_produccion"
BETTER_AUTH_URL="https://tu-dominio.com"
NEXT_PUBLIC_BETTER_AUTH_URL="https://tu-dominio.com"

# Microsoft OAuth / Azure Entra ID Credentials
# Registra tu aplicación en Azure Portal -> App registrations
# 1. Agrega el Redirect URI: https://tu-dominio.com/api/auth/callback/microsoft
# 2. Copia el Application (client) ID y genera un Client Secret.
MICROSOFT_CLIENT_ID="00000000-0000-0000-0000-000000000000"
MICROSOFT_CLIENT_SECRET="tu_client_secret_de_azure"
MICROSOFT_TENANT_ID="common" # "common" para cualquier cuenta Outlook/Microsoft, o el Tenant ID de tu empresa
