DATABASE_URL="file:./db/custom.db"
TURSO_DATABASE_URL="libsql://nombre-db-usuario.turso.io"
TURSO_AUTH_TOKEN="tu-token-jwt-de-turso"
BETTER_AUTH_SECRET="generar-con-openssl-rand-base64-32"
BETTER_AUTH_URL="https://tu-dominio.vercel.app"
ADMIN_EMAIL="admin@tudominio.com"
ADMIN_INITIAL_PASSWORD="TuPasswordSeguro2026!"

# Almacén de archivos subidos (planos PDF del Cronograma/Ingeniería)
# - Con TURSO_DATABASE_URL definida (producción serverless: AWS Lambda/Vercel),
#   los PDF se guardan como BLOB dentro de la misma base de datos Turso
#   (tabla "UploadedFile"). NO se usa el filesystem, por lo que ya no ocurren
#   errores tipo "ENOENT: mkdir '/var/task/uploads'" y los archivos persisten
#   y son accesibles desde cualquier instancia. LVE_UPLOAD_DIR no es necesaria.
# - Sin Turso (desarrollo local / Docker con volumen), se guarda en disco en
#   ./uploads; opcionalmente puedes reubicarlo con LVE_UPLOAD_DIR.
LVE_UPLOAD_DIR=""
